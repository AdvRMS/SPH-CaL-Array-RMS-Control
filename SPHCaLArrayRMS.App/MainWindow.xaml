<Window x:Class="SPHCaLArrayRMS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SPHCaLArrayRMS.Core.Models;assembly=SPHCaLArrayRMS.Core"
        Title="SPH CaL Array RMS - Control"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="700"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#17202A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#667085"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E1E6EC"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F8FAFB"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6FED"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2EAE66"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C84545"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#CDD5DF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFF2F2"/>
            <Setter Property="BorderBrush" Value="#E7B7B7"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#DCE2E8"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>

        <Style x:Key="SmallActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CDD5DF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CDD5DF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#F7F9FB"/>
            <Setter Property="Foreground" Value="#475467"/>
            <Setter Property="BorderBrush" Value="#E6EAF0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#EAF7EF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type models:HeaterControlModule}">
            <StackPanel Margin="2">
                <TextBlock Text="Channel" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                <ComboBox SelectedItem="{Binding Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding DataContext.HeaterChannels, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                          Margin="0,0,0,13"/>
                <TextBlock Text="Power (W)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding PowerWatts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,13"/>
                <TextBlock Text="Action" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                <ComboBox SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding DataContext.SwitchActions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                          Margin="0,0,0,13"/>
                <TextBlock Text="Duration (s)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding DurationInSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                <TextBlock Text="Resolution 0.01 s" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:ValveControlModule}">
            <StackPanel Margin="2">
                <TextBlock Text="Valve" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                <ComboBox SelectedItem="{Binding Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding DataContext.ValveChannels, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                          Margin="0,0,0,13"/>
                <TextBlock Text="Action" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                <ComboBox SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding DataContext.ValveActions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:WaitModule}">
            <StackPanel Margin="2">
                <TextBlock Text="Duration (s)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding DurationInSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
                <TextBlock Text="Resolution 0.01 s" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:LoopStartModule}">
            <StackPanel Margin="2">
                <TextBlock Text="Loop Count" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding LoopCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:LoopEndModule}">
            <Border Background="#F8FAFB" BorderBrush="#E6EAF0" BorderThickness="1" CornerRadius="6" Padding="12">
                <TextBlock Text="End of the current loop block" Foreground="{StaticResource TextSecondary}"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E3E7EC" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="SPH CaL Array RMS - Control"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F2F5F8" CornerRadius="8" Padding="14,8" Margin="0,0,8,0">
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    </Border>
                    <Border Background="#F2F5F8" CornerRadius="8" Padding="14,8">
                        <TextBlock Text="{Binding CurrentGlobalLoopText}" Foreground="#475467"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="168"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Hardware" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Connection status" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="330" Background="#F8FAFB" BorderBrush="#E1E6EC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Margin="0,0,9,0" Stroke="#8A939F" StrokeThickness="1">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#B3BAC2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsValveConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="Valve Relay Board" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding ValveConnectionText}"
                                        Command="{Binding ToggleValveConnectionCommand}"
                                        Width="92"
                                        Margin="14,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Width="330" Background="#F8FAFB" BorderBrush="#E1E6EC" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Margin="0,0,9,0" Stroke="#8A939F" StrokeThickness="1">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#B3BAC2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeaterConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="Heater Relay Board" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding HeaterConnectionText}"
                                        Command="{Binding ToggleHeaterConnectionCommand}"
                                        Width="92"
                                        Margin="14,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="245"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Module Toolbox" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Build the process sequence" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Process Modules" FontWeight="SemiBold" Foreground="#475467" Margin="0,0,0,8"/>
                            <Button Content="Valve Control" Command="{Binding AddModuleCommand}" CommandParameter="Valve" Style="{StaticResource ToolButton}"/>
                            <Button Content="Heater Control" Command="{Binding AddModuleCommand}" CommandParameter="Heater" Style="{StaticResource ToolButton}"/>
                            <Button Content="Wait" Command="{Binding AddModuleCommand}" CommandParameter="Wait" Style="{StaticResource ToolButton}"/>
                            <Border BorderBrush="#E6EAF0" BorderThickness="0,1,0,0" Margin="0,8,0,14"/>
                            <TextBlock Text="Loop Control" FontWeight="SemiBold" Foreground="#475467" Margin="0,0,0,8"/>
                            <Button Content="Loop Start" Command="{Binding AddModuleCommand}" CommandParameter="LoopStart" Style="{StaticResource ToolButton}"/>
                            <Button Content="Loop End" Command="{Binding AddModuleCommand}" CommandParameter="LoopEnd" Style="{StaticResource ToolButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="62"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="54"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="#E7EBF0" BorderThickness="0,0,0,1" Padding="16,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Process Editor" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Arrange modules in execution order" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1" Margin="14,12">
                            <Border Background="White" BorderBrush="#E1E6EC" BorderThickness="1" CornerRadius="7">
                                <ListView x:Name="ProcessList"
                                          ItemsSource="{Binding ProcessModules}"
                                          SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                                          BorderThickness="0"
                                          Background="Transparent">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Module" Width="180" DisplayMemberBinding="{Binding ModuleType}"/>
                                            <GridViewColumn Header="Details" Width="430" DisplayMemberBinding="{Binding Summary}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ProcessList, Path=HasItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="No process modules yet" FontWeight="SemiBold" Foreground="#667085" HorizontalAlignment="Center"/>
                                <TextBlock Text="Use the Module Toolbox to build a process" Foreground="#98A2B3" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="2" BorderBrush="#E7EBF0" BorderThickness="0,1,0,0" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Up" Command="{Binding MoveUpCommand}" Style="{StaticResource SmallActionButton}" Width="72" Margin="0,0,6,0"/>
                                    <Button Content="Down" Command="{Binding MoveDownCommand}" Style="{StaticResource SmallActionButton}" Width="72" Margin="0,0,6,0"/>
                                    <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource SmallActionButton}" Width="76" Margin="0,0,6,0"/>
                                    <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource SmallActionButton}" Width="72"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Load" Command="{Binding LoadCommand}" Style="{StaticResource SmallActionButton}" Width="76" Margin="0,0,6,0"/>
                                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource SmallActionButton}" Width="76"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Parameter Editor" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Edit the selected module" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="2">
                            <ContentControl Content="{Binding SelectedModule}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedModule}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="220">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedModule}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Select a module" FontWeight="SemiBold" Foreground="#667085" HorizontalAlignment="Center"/>
                                <TextBlock Text="Its editable parameters will appear here" TextWrapping="Wrap" TextAlignment="Center" Foreground="#98A2B3" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="410"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="#E7EBF0" BorderThickness="0,0,0,1" Padding="16,0">
                            <TextBlock Text="Event Log" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                        </Border>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding EventLog}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Padding="12"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Run Control" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Execution and timing" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Global Loop" Foreground="#475467" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding GlobalLoopCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="70"
                                         IsEnabled="{Binding IsProcessIdle}"
                                         TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F8FAFB" CornerRadius="7" Padding="10,8">
                                <TextBlock Text="{Binding ElapsedText}" TextAlignment="Center" Foreground="#475467"/>
                            </Border>
                            <Border Grid.Column="2" Background="#F8FAFB" CornerRadius="7" Padding="10,8">
                                <TextBlock Text="{Binding RemainingText}" TextAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </Border>
                            <Border Grid.Column="4" Background="#F8FAFB" CornerRadius="7" Padding="10,8">
                                <TextBlock Text="{Binding EstimatedEndTimeText}" TextAlignment="Center" Foreground="#475467"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Run Process"
                                    Command="{Binding RunCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="40"/>
                            <Button Grid.Column="2"
                                    Content="Stop"
                                    Command="{Binding StopCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Height="40"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
